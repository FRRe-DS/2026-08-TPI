# Configuración del Servidor M9
PORT=8089
NODE_ENV=development

# Base de Datos PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=m9_reservas
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/m9_reservas

# Seguridad / Autenticación (JWT HS256 clave compartida)
JWT_SECRET=clave-secreta-desarrollo-compartida-utn-frre-m9
JWT_ISSUER=utn-frre-arquitectura
JWT_AUDIENCE=utn-frre-ecosistema

# Ventanas de Anticipación (RF-9.2)
ANTICIPACION_MINIMA_MINUTOS=30
ANTICIPACION_MAXIMA_DIAS=30

# Integraciones Externas (URLs base de los otros módulos)
# Si no están levantados los otros módulos, se activa automáticamente el modo MOCK resiliente.
M2_CLIENTES_URL=http://localhost:8082
M4_UBICACION_URL=http://localhost:8084
M5_DESPACHO_URL=http://localhost:8085
M7_TARIFAS_URL=http://localhost:8087
M8_NOTIFICACIONES_URL=http://localhost:8088

# Forzar mocks locales de integración para desarrollo sin dependencias de red
USE_EXTERNAL_MOCKS=false
